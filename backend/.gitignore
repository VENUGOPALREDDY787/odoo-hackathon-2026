*.log
odoo.log
odoo-server.log

# Odoo generated files
filestore/
sessions/

# Odoo configuration
odoo.conf

# Odoo database dumps
*.dump
*.sql
*.sql.gz

# -------------------------
# PostgreSQL
# -------------------------
*.sqlite
*.sqlite3

