# -------------------------
__pycache__/
*.py[cod]
*$py.class

*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
htmlcov/

# Python virtual environments
venv/
.venv/
env/
ENV/

