# Public entry point: frontend + API behind one origin.
#
#  /            -> frontend (static SPA, proxied from the frontend container)
#  /api         -> backend_pool (all backend replicas, least_conn)
#  /socket.io   -> backend_pool (WebSocket upgrade aware)

upstream frontend_pool {
    server frontend:80;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 12m;

    # ---------------------------------------------------------------
    # API -> backend replicas
    # ---------------------------------------------------------------
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Never retry non-idempotent verbs on another replica — a retried
        # POST could double-create a quotation. Idempotent GETs may retry.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 10s;

        proxy_pass http://backend_pool;
    }

    # ---------------------------------------------------------------
    # Socket.IO -> backend replicas (WebSocket upgrades)
    # ---------------------------------------------------------------
    location /socket.io/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_read_timeout 86400; # keep websockets open
        proxy_pass http://backend_pool;
    }

    # ---------------------------------------------------------------
    # Frontend SPA
    # ---------------------------------------------------------------
    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_pass http://frontend_pool;
    }

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'lb-healthy\n';
    }
}
